# Copy to .env and fill in. .env is gitignored — never commit a real key.

# --- LLM (primary conversation driver) ---
# Without this key the server falls back to the deterministic planner (agent/planner.ts).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Optional cloud voice adapters ---
# Unset => browser-native Web Speech API (STT) + speechSynthesis (TTS). Zero cost, zero keys.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- Server ---
PORT=8787
DB_PATH=./data/booking.db

# Hold-token signing secret. Random per process if unset.
HOLD_TOKEN_SECRET=
